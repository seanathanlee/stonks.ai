      "name": "[format('{0}/{1}/{2}', format('{0}adx', parameters('baseName')), 'stonksai', 'create-agent-stock-forecast-mv')]",
      "properties": {
        "scriptContent": ".create-or-alter materialized-view with (backfill=true) agentStockForecastMV on table agentStockForecast\n{\n    agentStockForecast\n    | summarize arg_max(reportTime, expectedReturn, rank) by agentName, symbol, horizon\n}\n",
