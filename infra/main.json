                  "httpGet": {
                    "path": "/api/health",
                    "port": 8000
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 3,
                  "timeoutSeconds": 5
                }
              ],
              "env": "[concat(createArray(createObject('name', 'AZURE_OPENAI_ENDPOINT', 'value', reference(resourceId('Microsoft.CognitiveServices/accounts', format('{0}-ai', parameters('baseName'))), '2023-05-01').endpoint), createObject('name', 'AZURE_OPENAI_DEPLOYMENT', 'value', 'gpt-4.1'), createObject('name', 'AZURE_OPENAI_CHAT_DEPLOYMENT', 'value', 'gpt-5.1'), createObject('name', 'AZURE_OPENAI_API_VERSION', 'value', '2025-01-01-preview'), createObject('name', 'ADX_CLUSTER_URI', 'value', reference(resourceId('Microsoft.Kusto/clusters', format('{0}adx', parameters('baseName'))), '2023-08-15').uri), createObject('name', 'ADX_DATABASE', 'value', 'stonksai'), createObject('name', 'CORS_ORIGINS', 'value', format('https://skewthis.com,https://www.skewthis.com,https://{0}', reference(resourceId('Microsoft.Web/staticSites', format('{0}-web', parameters('baseName'))), '2023-01-01').defaultHostname))), if(not(equals(parameters('azureOpenAIApiKey'), '')), createArray(createObject('name', 'AZURE_OPENAI_API_KEY', 'secretRef', 'azure-openai-api-key')), createArray()))]"
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3
          }
        }
