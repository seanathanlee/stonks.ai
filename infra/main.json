    {
      "type": "Microsoft.Kusto/clusters/databases/scripts",
      "apiVersion": "2023-08-15",
      "name": "[format('{0}/{1}/{2}', format('{0}adx', parameters('baseName')), 'stonksai', 'create-daily-stock-price-table')]",
      "properties": {
        "scriptContent": ".create-merge table dailyStockPrice (\n    reportTime: datetime,\n    symbol: string,\n    price: real,\n    priceDate: datetime\n)\n\n.alter-merge table dailyStockPrice policy retention softdelete = 365d\n\n.create-or-alter table dailyStockPrice ingestion json mapping 'dailyStockPriceMapping'\n'[{\"column\":\"reportTime\",\"path\":\"$.reportTime\",\"datatype\":\"datetime\"},{\"column\":\"symbol\",\"path\":\"$.symbol\",\"datatype\":\"string\"},{\"column\":\"price\",\"path\":\"$.price\",\"datatype\":\"real\"},{\"column\":\"priceDate\",\"path\":\"$.priceDate\",\"datatype\":\"datetime\"}]'\n",
        "continueOnErrors": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Kusto/clusters/databases', format('{0}adx', parameters('baseName')), 'stonksai')]"
      ]
    },
    {
      "type": "Microsoft.Kusto/clusters/databases/scripts",
      "apiVersion": "2023-08-15",
      "name": "[format('{0}/{1}/{2}', format('{0}adx', parameters('baseName')), 'stonksai', 'create-agent-stock-forecast-table')]",
      "properties": {
        "scriptContent": ".create-merge table agentStockForecast (\n    reportTime: datetime,\n    agentName: string,\n    symbol: string,\n    horizon: string,\n    expectedReturn: real,\n    rank: int\n)\n\n.alter-merge table agentStockForecast policy retention softdelete = 365d\n\n.create-or-alter table agentStockForecast ingestion json mapping 'agentStockForecastMapping'\n'[{\"column\":\"reportTime\",\"path\":\"$.reportTime\",\"datatype\":\"datetime\"},{\"column\":\"agentName\",\"path\":\"$.agentName\",\"datatype\":\"string\"},{\"column\":\"symbol\",\"path\":\"$.symbol\",\"datatype\":\"string\"},{\"column\":\"horizon\",\"path\":\"$.horizon\",\"datatype\":\"string\"},{\"column\":\"expectedReturn\",\"path\":\"$.expectedReturn\",\"datatype\":\"real\"},{\"column\":\"rank\",\"path\":\"$.rank\",\"datatype\":\"int\"}]'\n",
        "continueOnErrors": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Kusto/clusters/databases', format('{0}adx', parameters('baseName')), 'stonksai')]"
      ]
    },
    {
      "type": "Microsoft.Kusto/clusters/databases/scripts",
      "apiVersion": "2023-08-15",
      "name": "[format('{0}/{1}/{2}', format('{0}adx', parameters('baseName')), 'stonksai', 'create-daily-stock-price-mv')]",
      "properties": {
        "scriptContent": ".create-or-alter materialized-view with (backfill=true) dailyStockPriceMV on table dailyStockPrice\n{\n    dailyStockPrice\n    | summarize arg_max(reportTime, price) by symbol, priceDate\n}\n",
        "continueOnErrors": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Kusto/clusters/databases', format('{0}adx', parameters('baseName')), 'stonksai')]",
        "[resourceId('Microsoft.Kusto/clusters/databases/scripts', format('{0}adx', parameters('baseName')), 'stonksai', 'create-daily-stock-price-table')]"
      ]
    },
    {
      "type": "Microsoft.Kusto/clusters/databases/scripts",
      "apiVersion": "2023-08-15",
      "name": "[format('{0}/{1}/{2}', format('{0}adx', parameters('baseName')), 'stonksai', 'create-agent-stock-evaluation-table')]",
      "properties": {
        "scriptContent": ".create-merge table agentStockEvaluation (\n    symbol: string,\n    forecastReturn: real,\n    actualReturn: real,\n    forecastRank: int,\n    actualRank: int,\n    accuracyScore: real,\n    agentName: string,\n    forecastReportTime: datetime,\n    reportTime: datetime,\n    runId: string,\n    horizon: string\n)\n\n.alter-merge table agentStockEvaluation policy retention softdelete = 365d\n\n.create-or-alter table agentStockEvaluation ingestion json mapping 'agentStockEvaluationMapping'\n'[{\"column\":\"symbol\",\"path\":\"$.symbol\",\"datatype\":\"string\"},{\"column\":\"forecastReturn\",\"path\":\"$.forecastReturn\",\"datatype\":\"real\"},{\"column\":\"actualReturn\",\"path\":\"$.actualReturn\",\"datatype\":\"real\"},{\"column\":\"forecastRank\",\"path\":\"$.forecastRank\",\"datatype\":\"int\"},{\"column\":\"actualRank\",\"path\":\"$.actualRank\",\"datatype\":\"int\"},{\"column\":\"accuracyScore\",\"path\":\"$.accuracyScore\",\"datatype\":\"real\"},{\"column\":\"agentName\",\"path\":\"$.agentName\",\"datatype\":\"string\"},{\"column\":\"forecastReportTime\",\"path\":\"$.forecastReportTime\",\"datatype\":\"datetime\"},{\"column\":\"reportTime\",\"path\":\"$.reportTime\",\"datatype\":\"datetime\"},{\"column\":\"runId\",\"path\":\"$.runId\",\"datatype\":\"string\"},{\"column\":\"horizon\",\"path\":\"$.horizon\",\"datatype\":\"string\"}]'\n",
        "continueOnErrors": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Kusto/clusters/databases', format('{0}adx', parameters('baseName')), 'stonksai')]",
        "[resourceId('Microsoft.Kusto/clusters/databases/scripts', format('{0}adx', parameters('baseName')), 'stonksai', 'create-agent-stock-forecast-table')]"
      ]
