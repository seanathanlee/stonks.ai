# Azure OpenAI settings
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
# Forecast backfills send large prompts to Azure OpenAI. Keep SDK retries off so
# the app-level retry/pacing wrapper can avoid quota bursts, and tune the call
# interval down only if your deployment has enough TPM/RPM capacity.
AZURE_OPENAI_MAX_RETRIES=0
AZURE_OPENAI_CALL_INTERVAL=65

# Azure Data Explorer (Kusto) settings
ADX_CLUSTER_URI=https://<cluster-name>.<region>.kusto.windows.net
ADX_DATABASE=stonksai
